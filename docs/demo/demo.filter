[3:v]scale=1000:600,setsar=1,format=rgb24[card];
[1:v]trim=5.8:8.78,setpts=PTS-STARTPTS,crop=2260:1226:792:444[a1];
[1:v]trim=17.5:22.4,setpts=PTS-STARTPTS,crop=2260:1226:792:444,tpad=stop_mode=clone:stop_duration=1.5[a2];

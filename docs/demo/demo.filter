[0:v]trim=0:7.1,setpts=PTS-STARTPTS,crop=2064:1230:800:480[b1];
[0:v]trim=16.0:19.5,setpts=PTS-STARTPTS,crop=2064:1230:800:480,split[b2a][b2b];
[b2b]crop=420:28:274:1186,boxblur=8:3:4:3[bl];
[b2a][bl]overlay=274:1186[b2];
[b1][b2]concat=n=2:v=1:a=0,scale=1000:-1,setsar=1[beat1s];
[beat1s][2:v]overlay=W-w-16:80[beat1l];

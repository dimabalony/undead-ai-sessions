[0:v]trim=0:6.0,setpts=PTS-STARTPTS,crop=2064:1096:800:610[b1];
[0:v]trim=16.0:19.5,setpts=PTS-STARTPTS,crop=2064:1096:800:610,split[b2a][b2b];
[b2b]crop=420:28:274:1056,boxblur=8:3:4:3[bl];
[b2a][bl]overlay=274:1056[b2];
[b1][b2]concat=n=2:v=1:a=0,scale=1000:531,setsar=1[beat1s];
[beat1s][2:v]overlay=W-w-16:16,format=rgb24[beat1];
[3:v]scale=1000:531,setsar=1,format=rgb24[card];
[1:v]trim=5.8:8.7,setpts=PTS-STARTPTS,crop=2064:1096:792:580[a1];
[1:v]trim=17.0:19.9,setpts=PTS-STARTPTS,crop=2064:1096:792:580,tpad=stop_mode=clone:stop_duration=2.2[a2];
[a1][a2]concat=n=2:v=1:a=0,scale=1000:531,setsar=1[beat2s];
[beat2s][4:v]overlay=W-w-16:16[beat2l];
[beat2l][5:v]overlay=(W-w)/2:H-h-70:enable='gte(t,5.9)',format=rgb24[beat2];
[beat1][card][beat2]concat=n=3:v=1:a=0,fps=12,split[p][q];
[p]palettegen=stats_mode=diff[pal];
[q][pal]paletteuse=dither=bayer:bayer_scale=5:diff_mode=rectangle
